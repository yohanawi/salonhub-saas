# Production environment template.
#
# This file is a REFERENCE for the .env you create on the actual production
# server — it is not meant to replace your local .env, and copying it over
# your local .env will break local development (no debug output, different
# artisan/session behavior). Copy this to `.env` only on the real production
# host, fill in the blanks, then run:
#   php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME=SaloonHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sync blocks the HTTP request on every job. Use a real queue in production
# (a "database" queue is the lowest-effort upgrade; requires a worker process
# running via `php artisan queue:work` or Supervisor).
QUEUE_CONNECTION=database

# File-based cache/session don't work across multiple app servers and are
# slower under load. Prefer "redis" if available; "database" is an acceptable
# fallback on a single server.
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Point this at a real transactional mail provider — Mailtrap is a sandbox
# and emails sent through it never reach real inboxes. config/services.php
# already has stubs for mailgun, postmark, and ses if you use one of those
# instead of raw SMTP.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
